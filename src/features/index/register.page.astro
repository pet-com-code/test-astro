---
import CustomAlert from "@/components/alert/CustomAlert.astro";

const title = "회원가입";
---

<div class="auth-card" data-theme="dog">
    <!-- 전역 알림 영역: 페이지 안에 하나만 배치 -->
    <CustomAlert />

    <div class="forms-container">
        <!-- 왼쪽 안내 패널 -->
        <section class="panel">
            <div class="panel-content">
                <p class="panel-eyebrow">WELCOME TO PETJUP</p>

                <h1 class="panel-title">
                    반려동물과 함께하는
                    <br />
                    새로운 시작
                </h1>

                <p class="panel-desc">
                    회원가입하고 반려동물의 소중한 순간을 함께 나누어 보세요.
                </p>

                <a href="/signin" class="panel-btn-link">
                    이미 계정이 있으신가요?
                    <span>로그인</span>
                </a>
            </div>
        </section>

        <!-- 회원가입 폼 -->
        <section class="form-box">
            <h2 class="form-title">{title}</h2>

            <p class="form-description">
                아래 정보를 입력하여 계정을 만들어 주세요.
            </p>

            <form id="registerForm" novalidate>
                <!-- 이메일 -->
                <div class="input-group">
                    <label for="email">이메일</label>

                    <input
                        id="email"
                        type="email"
                        name="email"
                        placeholder="example@email.com"
                        class="auth-input"
                        autocomplete="email"
                        aria-label="이메일"
                        required
                    />
                </div>

                <!-- 사용자 이름 -->
                <div class="input-group">
                    <label for="name">이름</label>

                    <input
                        id="name"
                        type="text"
                        name="name"
                        placeholder="이름을 입력해 주세요."
                        class="auth-input"
                        autocomplete="name"
                        aria-label="이름"
                        minlength="2"
                        maxlength="100"
                        required
                    />
                </div>

                <!-- 비밀번호 -->
                <div class="input-group">
                    <label for="password">비밀번호</label>

                    <input
                        id="password"
                        type="password"
                        name="password"
                        placeholder="비밀번호를 입력해 주세요."
                        class="auth-input"
                        autocomplete="new-password"
                        aria-label="비밀번호"
                        minlength="6"
                        maxlength="20"
                        required
                    />

                    <p class="input-help">
                        6~20자이며 특수문자를 하나 이상 포함해 주세요.
                    </p>
                </div>

                <!-- 비밀번호 확인 -->
                <div class="input-group">
                    <label for="repassword">비밀번호 확인</label>

                    <input
                        id="repassword"
                        type="password"
                        name="repassword"
                        placeholder="비밀번호를 다시 입력해 주세요."
                        class="auth-input"
                        autocomplete="new-password"
                        aria-label="비밀번호 확인"
                        required
                    />
                </div>

                <!-- 회원가입 버튼 -->
                <button id="registerSubmit" type="submit" class="submit-btn">
                    회원가입
                </button>
            </form>

            <!-- 구분선 -->
            <div class="divider">
                <span></span>
                <p>또는 SNS 계정으로 가입</p>
                <span></span>
            </div>

            <!-- SNS 가입 -->
            <div class="sns-buttons">
                <a
                    href="/api/auth/oauth/google"
                    class="sns-btn google-btn"
                    aria-label="Google 계정으로 가입"
                >
                    <span class="sns-icon" aria-hidden="true">
                        G
                    </span>
                    Google
                </a>

                <a
                    href="/api/auth/oauth/kakao"
                    class="sns-btn kakao-btn"
                    aria-label="Kakao 계정으로 가입"
                >
                    <span class="sns-icon" aria-hidden="true">
                        K
                    </span>
                    Kakao
                </a>
            </div>

            <p class="bottom-link">
                이미 회원이신가요?
                <a href="/signin">로그인</a>
            </p>
        </section>
    </div>
</div>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    .auth-card {
        width: min(100% - 2rem, 960px);
        min-height: 620px;
        margin: 3rem auto;
        overflow: hidden;
        border: 1px solid #e5e7eb;
        border-radius: 1.5rem;
        background: #ffffff;
        box-shadow: 0 20px 60px rgb(15 23 42 / 8%);
        color: #1f2937;
    }

    .forms-container {
        display: flex;
        min-height: 620px;
    }

    /* 왼쪽 안내 패널 */
    .panel {
        display: flex;
        width: 40%;
        align-items: center;
        justify-content: center;
        padding: 2.5rem;
        background: linear-gradient(145deg, #166534, #15803d);
        color: #ffffff;
    }

    .panel-content {
        width: 100%;
        max-width: 300px;
    }

    .panel-eyebrow {
        margin: 0 0 1rem;
        color: #bbf7d0;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.12em;
    }

    .panel-title {
        margin: 0 0 1.25rem;
        font-size: clamp(1.7rem, 3vw, 2.2rem);
        font-weight: 800;
        line-height: 1.45;
        word-break: keep-all;
    }

    .panel-desc {
        margin: 0 0 2rem;
        color: #dcfce7;
        font-size: 0.95rem;
        line-height: 1.8;
        word-break: keep-all;
    }

    .panel-btn-link {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        justify-content: space-between;
        padding: 0.9rem 1rem;
        border: 1px solid rgb(255 255 255 / 35%);
        border-radius: 0.75rem;
        color: #ffffff;
        font-size: 0.85rem;
        text-decoration: none;
        transition: background-color 0.2s ease;
    }

    .panel-btn-link span {
        font-weight: 800;
    }

    .panel-btn-link:hover {
        background: rgb(255 255 255 / 12%);
    }

    /* 오른쪽 폼 */
    .form-box {
        display: flex;
        width: 60%;
        flex-direction: column;
        justify-content: center;
        padding: 3rem clamp(1.5rem, 4vw, 3.5rem);
    }

    .form-title {
        margin: 0 0 0.5rem;
        color: #111827;
        font-size: 1.8rem;
        font-weight: 800;
    }

    .form-description {
        margin: 0 0 1.75rem;
        color: #6b7280;
        font-size: 0.9rem;
        line-height: 1.6;
    }

    #registerForm {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    .input-group label {
        color: #374151;
        font-size: 0.875rem;
        font-weight: 700;
    }

    .auth-input {
        width: 100%;
        min-height: 46px;
        padding: 0.8rem 0.9rem;
        border: 1px solid #d1d5db;
        border-radius: 0.65rem;
        outline: none;
        background: #ffffff;
        color: #111827;
        font: inherit;
        font-size: 0.9rem;
        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .auth-input::placeholder {
        color: #9ca3af;
    }

    .auth-input:focus {
        border-color: #16a34a;
        box-shadow: 0 0 0 3px rgb(22 163 74 / 12%);
    }

    .auth-input:disabled {
        cursor: not-allowed;
        background: #f3f4f6;
    }

    .input-help {
        margin: 0;
        color: #6b7280;
        font-size: 0.75rem;
        line-height: 1.5;
    }

    .submit-btn {
        width: 100%;
        min-height: 48px;
        margin-top: 0.5rem;
        padding: 0.85rem 1rem;
        border: 0;
        border-radius: 0.7rem;
        background: #15803d;
        color: #ffffff;
        font: inherit;
        font-size: 0.95rem;
        font-weight: 800;
        cursor: pointer;
        transition:
            background-color 0.2s ease,
            transform 0.2s ease;
    }

    .submit-btn:hover:not(:disabled) {
        transform: translateY(-1px);
        background: #166534;
    }

    .submit-btn:disabled {
        cursor: wait;
        opacity: 0.65;
    }

    /* SNS 구분선 */
    .divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 1.5rem 0 1rem;
    }

    .divider span {
        height: 1px;
        flex: 1;
        background: #e5e7eb;
    }

    .divider p {
        margin: 0;
        color: #9ca3af;
        font-size: 0.75rem;
        white-space: nowrap;
    }

    .sns-buttons {
        display: flex;
        gap: 0.75rem;
    }

    .sns-btn {
        display: flex;
        min-height: 44px;
        flex: 1;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.7rem 1rem;
        border: 1px solid transparent;
        border-radius: 0.65rem;
        font-size: 0.875rem;
        font-weight: 700;
        text-decoration: none;
        transition:
            background-color 0.2s ease,
            border-color 0.2s ease;
    }

    .sns-icon {
        display: inline-flex;
        width: 1.25rem;
        height: 1.25rem;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 900;
    }

    .google-btn {
        border-color: #e5e7eb;
        background: #ffffff;
        color: #1f2937;
    }

    .google-btn:hover {
        background: #f9fafb;
    }

    .kakao-btn {
        border-color: #fee500;
        background: #fee500;
        color: #191919;
    }

    .kakao-btn:hover {
        border-color: #fada0a;
        background: #fada0a;
    }

    .bottom-link {
        margin: 1.5rem 0 0;
        color: #6b7280;
        font-size: 0.85rem;
        text-align: center;
    }

    .bottom-link a {
        margin-left: 0.25rem;
        color: #15803d;
        font-weight: 800;
        text-decoration: none;
    }

    .bottom-link a:hover {
        text-decoration: underline;
    }

    /* 작은 화면 대응 */
    @media (max-width: 700px) {
        .auth-card {
            width: min(100% - 1rem, 480px);
            min-height: auto;
            margin: 1rem auto;
            border-radius: 1rem;
        }

        .forms-container {
            min-height: auto;
            flex-direction: column;
        }

        .panel,
        .form-box {
            width: 100%;
        }

        .panel {
            min-height: auto;
            padding: 1.75rem 1.5rem;
        }

        .panel-title {
            font-size: 1.5rem;
        }

        .panel-desc {
            margin-bottom: 1.25rem;
        }

        .form-box {
            padding: 2rem 1.25rem;
        }
    }

    @media (max-width: 380px) {
        .sns-buttons {
            flex-direction: column;
        }

        .sns-btn {
            width: 100%;
        }
    }
</style>

<script>
    import { z } from "zod";
    import { showAlert } from "@/lib/alert";
    import { navigate } from "astro:transitions/client";

    // 1. 회원가입 입력값 검증
    const registerSchema = z
        .object({
            email: z
                .string()
                .trim()
                .min(1, "이메일을 입력해주세요.")
                .email("올바른 이메일 형식이 아닙니다.")
                .max(254, "이메일은 254자 이하여야 합니다."),

            name: z
                .string()
                .trim()
                .min(2, "이름은 2자 이상 입력해주세요.")
                .max(100, "이름은 100자 이하여야 합니다."),

            password: z
                .string()
                .min(6, "비밀번호는 6자 이상이어야 합니다.")
                .max(20, "비밀번호는 20자 이하여야 합니다.")
                .regex(
                    /[^A-Za-z0-9]/,
                    "비밀번호에 특수문자를 하나 이상 포함해주세요."
                ),

            repassword: z.string().min(1, "비밀번호 확인을 입력해주세요.")
        })
        .refine((data) => data.password === data.repassword, {
            // password와 repassword가 서로 똑같은지 비교하여
            // 비밀번호 확인 일치 여부를 검사
            message: "비밀번호가 일치하지 않습니다.",
            path: ["repassword"]
        });

    // 2. Astro 회원가입 API 응답 검증
    const registerResponseSchema = z.object({
        success: z.boolean(),
        message: z.string().optional(),
        error: z.string().optional()
    });

    // 3. 응답 본문을 안전하게 JSON으로 읽기
    async function readJsonSafely(response: Response): Promise<unknown> {
        // 서버가 보낸 응답 결과가 우리가 예상한 규칙(success, message, error)대로 
        // 들어왔는지 확인하고, 서버 응답이 깨져있더라도 에러로 인해 웹사이트 전체가 멈추지 
        // 않도록 안전하게 데이터를 읽어오는 역할을 합니다.
        try {
            return await response.json();
        } catch {
            return null;
        }
    }

    // 4. 회원가입 폼 초기화 및 중복 등록 방지
    function initRegisterProcess() {
        const registerForm = document.getElementById(
            "registerForm"
        ) as HTMLFormElement | null;

        // 페이지가 없거나 이미 이벤트를 등록했다면 종료
        if (
            !registerForm ||
            registerForm.dataset.registerInitialized === "true"
            // Astro의 페이지 전환 특성상 꼭 필요한 안전장치
            // dataset을 활용해 "이 폼은 이미 초기화 완료되었음"이라는 도장을 쾅 찍어두는 기법
        ) {
            return;
        }

        registerForm.dataset.registerInitialized = "true";

        const submitButton = registerForm.querySelector<HTMLButtonElement>(
            'button[type="submit"]'
        );

        let isSubmitting = false; // 현재 가입 요청이 진행 중인지를 기억하는 변수

        // 5. 폼 제출 처리
        registerForm.addEventListener("submit", async (event: SubmitEvent) => {
            event.preventDefault(); // 새로고침 해버리는 기본 동작을 막아줍니다

            // 중복 제출 방지
            if (isSubmitting) return;

            // 6. 입력값 수집, FormData()
            // 입력창에 적힌 값들을 쉽게 꺼낼 수 있도록 묶어주는 브라우저 내장 기능
            const formData = new FormData(registerForm); 
            // FormData() : 입력창에 적힌 값들을 쉽게 꺼낼 수 있도록 묶어주는 브라우저 내장 기능

            const rawData = {
                email: String(formData.get("email") ?? ""),
                name: String(formData.get("name") ?? ""),
                password: String(formData.get("password") ?? ""),
                repassword: String(formData.get("repassword") ?? "")
            };

            // 7. 클라이언트 입력값 검증
            // 사용자가 입력한 값들을 통과시키기 전에 zod를 활용해 검증합니다.
            // safeParse는 에러를 뿜으며 멈추지 않고, 결과가 성공인지 실패(success: false)인지만 알려줍니다. 
            const validationResult = registerSchema.safeParse(rawData);

            if (!validationResult.success) {
                // 검증 실패 시, 첫 번째 에러 메시지를 사용자에게 보여주고
                // 해당 입력창에 포커스를 맞춰줍니다.
                const firstIssue = validationResult.error.issues[0];

                showAlert(firstIssue.message, "warning");

                const fieldName = firstIssue.path[0];

                if (typeof fieldName === "string") {
                    const invalidField =
                        registerForm.querySelector<HTMLInputElement>(
                            `[name="${fieldName}"]`
                        );

                    invalidField?.focus();
                }

                return;
            }

            // 8. 요청 중 상태 설정
            // 요청 중 시각적 피드백 제공 (UX/접근성)

            isSubmitting = true;

            if (submitButton) {
                // 버튼을 비활성화하고 텍스트를 바꿉니다.
                submitButton.disabled = true;
                submitButton.textContent = "가입 처리 중...";
            }

            // aria-busy="true"는 눈이 불편해 화면 낭독기(스크린 리더)를 사용하는 분들에게
            // "현재 이 영역이 로딩 중입니다"라고 알려주는 웹 접근성 표준 규격입니다.
            registerForm.setAttribute("aria-busy", "true");

            try {
                // 9. Astro API로 회원가입 요청
                // repassword는 서버에 전송하지 않습니다.
                const response = await fetch("/api/signup", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        Accept: "application/json"
                    },
                    body: JSON.stringify({
                        email: validationResult.data.email,
                        username: validationResult.data.name,
                        password: validationResult.data.password
                    })
                });

                // 10. 서버 응답 파싱 및 검증
                const rawJson = await readJsonSafely(response);

                const parsedResponse =
                    registerResponseSchema.safeParse(rawJson);

                if (
                    !response.ok ||
                    !parsedResponse.success ||
                    !parsedResponse.data.success
                ) {
                    const message = parsedResponse.success
                        ? parsedResponse.data.error
                        : undefined;

                    throw new Error(
                        message ||
                            "회원가입에 실패했습니다. 입력 정보를 확인해주세요."
                    );
                }

                // 11. 회원가입 성공
                showAlert(
                    parsedResponse.data.message || "회원가입이 완료되었습니다.",
                    "success"
                );

                // 12. 로그인 페이지로 이동
                window.setTimeout(() => {
                    navigate("/signin");
                }, 1200);
            } catch (error: unknown) {
                const message =
                    error instanceof Error
                        ? error.message
                        : "회원가입 중 오류가 발생했습니다.";

                showAlert(message, "error");
            } finally {
                // 성공 시에는 페이지 이동을 기다리고,
                // 실패 시에는 다시 제출할 수 있도록 복구합니다.
                const currentButton = submitButton;

                if (currentButton && !isSubmitting) {
                    currentButton.disabled = false;
                }

                if (submitButton) {
                    submitButton.textContent = "회원가입";
                }

                registerForm.removeAttribute("aria-busy");

                // 성공 후 이동 전 중복 제출을 방지합니다.
                // 실패한 경우에만 재제출을 허용합니다.
                if (!registerForm.dataset.registrationSucceeded) {
                    isSubmitting = false;

                    if (submitButton) {
                        submitButton.disabled = false;
                    }
                }
            }
        });
    }

    // 13. Astro 페이지 로드 및 View Transitions 대응
    // Astro 프레임워크는 페이지를 이동할 때 화면 전체를 새로고침 하지 않고 필요한 부분만 
    // 바꾸는 'View Transitions' 기능을 씁니다. 이때 브라우저의 기본 onload 이벤트가 실행되지 
    // 않을 수 있으므로, Astro 전용 이벤트인 astro:page-load를 감시하여 화면이 바뀔 때마다 
    // 회원가입 폼 감시기 기능이 완벽하게 켜지도록 보장합니다.
    document.addEventListener("astro:page-load", initRegisterProcess);

    // 페이지가 이미 로드된 상황도 처리
    initRegisterProcess();
</script>
