---
interface Props {
    id?: string;
    icon?: string;
    message?: string;
}

const {
    id = "audio-guide-bubble",
    icon = "📸",
    message = "화면을 클릭하면<br />셔터 소리와 함께 시작됩니다!"
} = Astro.props;
---

<!-- 1. 바깥 레이어: 고정 위치 잡기 -->
<div id={id} class="audio-guide-container">
    <!-- 2. 안쪽 레이어: 둥둥 떠있는 애니메이션 및 구름 모양 -->
    <div class="cloud-bubble">
        <!-- 아이콘 & 메시지 -->
        <span class="bubble-icon">{icon}</span>
        <p class="bubble-message" set:html={message} />

        <!-- 구름 아래 몽글몽글 꼬리 방울 2개 -->
        <div class="bubble-tail-large"></div>
        <div class="bubble-tail-small"></div>
    </div>
</div>

<style>
    /* 1. 바깥 레이어 (고정 위치 및 트랜지션) */
    .audio-guide-container {
        position: fixed;
        top: 50%;
        left: 50%;
        z-index: 100000;
        transform: translate(-50%, -50%);
        pointer-events: none;
        transition: all 0.3s ease;
    }

    /* 2. 안쪽 레이어 (구름 모양 및 둥둥 애니메이션) */
    .cloud-bubble {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 40px;

        /* 🎨 변경: theme.css의 각 테마별 주요 브랜드 컬러 바인딩 */
        background-color: var(--color-primary);
        color: var(--color-primary-content);

        border: 1px solid rgba(255, 255, 255, 0.4);
        padding: 1rem 1.5rem;

        /* 🎨 변경: theme.css의 그림자 효과 적용 */
        box-shadow: var(--custom-shadow);

        animation: bounce 1s infinite;
        transition:
            background-color 0.3s ease,
            color 0.3s ease; /* 테마 변경 시 부드러운 전환 효과 */
    }

    /* 아이콘 스타일 */
    .bubble-icon {
        display: block;
        margin-bottom: 0.25rem;
        font-size: 1.5rem;
        filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.05));
    }

    /* 메시지 텍스트 스타일 */
    .bubble-message {
        margin: 0;
        text-align: center;
        font-size: 0.875rem;
        line-height: 1.625;
        font-weight: 700;
        white-space: nowrap;
    }

    /* 꼬리 방울 공통 스타일 */
    .bubble-tail-large,
    .bubble-tail-small {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        border-radius: 9999px;

        /* 🎨 변경: 꼬리 방울 색상도 본체 구름과 동일하게 변수 바인딩 */
        background-color: var(--color-primary);
        transition: background-color 0.3s ease;
    }

    /* 큰 꼬리 방울 */
    .bubble-tail-large {
        bottom: -0.5rem;
        height: 1rem;
        width: 1rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    /* 작은 꼬리 방울 */
    .bubble-tail-small {
        bottom: -1rem;
        height: 0.5rem;
        width: 0.5rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
    }

    /* 3. Tailwind bounce 애니메이션 순수 CSS 구현 */
    @keyframes bounce {
        0%,
        100% {
            transform: translateY(-25%);
            animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
        }
        50% {
            transform: translateY(0);
            animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
        }
    }

    /* 4. 사라지는 상태 스타일 (외부 스크립트 대응용 :global) */
    :global(#audio-guide-bubble.guide-bubble-fade-out),
    :global(.guide-bubble-fade-out) {
        opacity: 0 !important;
        transform: translate(-50%, -80%) scale(0.7) !important;
    }

    /* 사라질 때 안쪽 레이어의 bounce 애니메이션 중단 처리 */
    :global(#audio-guide-bubble.guide-bubble-fade-out) .cloud-bubble,
    :global(.guide-bubble-fade-out) .cloud-bubble {
        animation: none !important;
    }
</style>
